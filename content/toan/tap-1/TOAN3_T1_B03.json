  "knowledge": {
    "introduction": "Một phép tính có thể bị che một số. Muốn tìm số đó, trước hết hãy xác định tên thành phần bị che, rồi chọn quy tắc phù hợp.",
    "rules": [
      "Số hạng chưa biết = tổng - số hạng đã biết.",
      "Số bị trừ = hiệu + số trừ.",
      "Số trừ = số bị trừ - hiệu.",
      "Thay số tìm được vào chỗ trống để kiểm tra phép tính ban đầu."
    ],
    "steps": [
      "Đọc tên các thành phần và đánh dấu số chưa biết.",
      "Nói quy tắc thành lời trước khi tính.",
      "Tính rồi thay đáp án vào phép tính ban đầu."
    ],
    "common_errors": [
      "Dùng cùng một quy tắc cho số bị trừ và số trừ.",
      "Tìm được số nhưng không thử lại.",
      "Nhầm số ban đầu với số còn lại trong bài toán."
    ]
