  "knowledge": {
    "introduction": "Hãy xếp những hộp trứng, mỗi hộp 6 quả. Thay vì đếm từng quả, ta đếm theo các nhóm 6. Khi biết tổng số quả, phép chia giúp tìm số hộp hoặc số quả mỗi phần.",
    "rules": [
      "Bảng nhân 6: 6, 12, 18, 24, 30, 36, 42, 48, 54, 60 tương ứng với nhân từ 1 đến 10.",
      "Thêm một nhóm 6 thì tích tăng 6; bớt một nhóm 6 thì tích giảm 6.",
      "Từ 6 × 8 = 48 suy ra 48 : 6 = 8. Dùng bảng nhân để nhớ bảng chia.",
      "Nhận rõ đề hỏi tất cả, số nhóm hay số đồ vật mỗi nhóm. Không lấy tổng trừ 6 một lần thay cho phép chia."
    ],
    "steps": [
      "Xếp các nhóm 6 bằng que tính hoặc chấm tròn.",
      "Tự lập các tích, đọc bảng xuôi rồi đọc ngược.",
      "Che một tích và dùng tích liền trước để suy ra.",
      "Giải bài toán bằng cách nêu số nhóm, số đồ vật mỗi nhóm và điều cần tìm."
    ],
    "common_errors": [
      "Nhầm 6 × 7 với 6 + 7.",
      "Nhớ nhầm 6 × 9 thành 48, là kết quả của 6 × 8.",
      "Cộng cả đồ vật có màu khác khi đề chỉ hỏi một màu."
    ]
  },
  "examples": [
    {
      "question": "Có 7 khay, mỗi khay 6 bánh. Hỏi có tất cả bao nhiêu bánh?",
      "steps": [
        "Có 7 nhóm 6 bánh.",
        "6 × 7 = 42. Có 42 chiếc bánh."
      ]
    },
    {
      "question": "Có 30 bút, mỗi hộp 6 bút. Xếp được mấy hộp?",
