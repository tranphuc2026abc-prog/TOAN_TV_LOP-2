  "knowledge": {
    "introduction": "Một tuần luôn có 7 ngày. Các tuần trọn vẹn tạo thành những nhóm 7 ngày, là một tình huống dễ nhớ để luyện bảng nhân 7. Ta còn gặp nhóm 7 trong các bộ thẻ, hàng cây và đội chơi.",
    "rules": [
      "Bảng nhân 7: 7, 14, 21, 28, 35, 42, 49, 56, 63, 70 ứng với nhân từ 1 đến 10.",
      "Các tích liên tiếp của bảng nhân 7 hơn kém nhau 7.",
      "Biết 7 × 6 = 42 thì biết 42 : 7 = 6; tương tự với các phép tính còn lại.",
      "Một tuần có 7 ngày; chỉ dùng số tuần nhân 7 khi tính số ngày của các tuần trọn vẹn."
    ],
    "steps": [
      "Gắn mỗi nhóm 7 với một thẻ tuần hoặc một nhóm đồ vật.",
      "Nhớ mốc 7 × 5 = 35, từ đó thêm hoặc bớt 7 để tìm tích gần đó.",
      "Đọc câu hỏi trước khi chọn nhân hay chia.",
      "Kiểm tra thương bằng phép nhân với 7; ghi đúng đơn vị."
    ],
    "common_errors": [
      "Lẫn 7 × 8 = 56 với 7 × 9 = 63.",
      "Dùng phép cộng 7 + số tuần thay cho nhân 7.",
      "Đếm nhầm một tuần là 5 ngày do chỉ tính ngày đi học."
    ]
  },
  "examples": [
    {
      "question": "Một hoạt động kéo dài 5 tuần trọn vẹn. Hỏi có bao nhiêu ngày?",
